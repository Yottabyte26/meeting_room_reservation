<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rbs.system.mapper.SysMeetingRoomMapper">
    
    <resultMap type="SysMeetingRoom" id="SysMeetingRoomResult">
        <result property="roomId"    column="room_id"    />
        <result property="roomName"    column="room_name"    />
        <result property="roomCode"    column="room_code"    />
        <result property="location"    column="location"    />
        <result property="capacity"    column="capacity"    />
        <result property="roomType"    column="room_type"    />
        <result property="status"    column="status"    />
        <result property="description"    column="description"    />
        <result property="isEnabled"    column="is_enabled"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysMeetingRoomVo">
        select room_id, room_name, room_code, location, capacity, room_type, status, description, is_enabled, create_by, create_time, update_by, update_time, remark from sys_meeting_room
    </sql>

    <!-- 会议室预定次数统计 -->
    <select id="selectRoomReservationList" resultType="com.rbs.system.domain.vo.RoomReservationVo">
        SELECT
            r.room_name AS roomName,
            COUNT(res.reservation_id) AS reservationCount
        FROM
            sys_meeting_room r
                LEFT JOIN
            sys_meeting_reservation res ON r.room_id = res.room_id AND res.status = '1'
        WHERE
            r.is_enabled = '1'
        GROUP BY
            r.room_id, r.room_name
        ORDER BY
            reservationCount DESC
    </select>

    <select id="selectSysMeetingRoomList" parameterType="SysMeetingRoom" resultMap="SysMeetingRoomResult">
        <include refid="selectSysMeetingRoomVo"/>
        <where>  
            <if test="roomName != null  and roomName != ''"> and room_name like concat('%', #{roomName}, '%')</if>
            <if test="roomCode != null  and roomCode != ''"> and room_code = #{roomCode}</if>
            <if test="location != null  and location != ''"> and location = #{location}</if>
            <if test="capacity != null "> and capacity = #{capacity}</if>
            <if test="roomType != null  and roomType != ''"> and room_type = #{roomType}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="isEnabled != null  and isEnabled != ''"> and is_enabled = #{isEnabled}</if>
        </where>
    </select>
    
    <select id="selectSysMeetingRoomByRoomId" parameterType="Long" resultMap="SysMeetingRoomResult">
        <include refid="selectSysMeetingRoomVo"/>
        where room_id = #{roomId}
    </select>
    <select id="selectSysMeetingReservationListByApplicantName"
            resultType="com.rbs.system.domain.SysMeetingReservation"></select>

    <insert id="insertSysMeetingRoom" parameterType="SysMeetingRoom" useGeneratedKeys="true" keyProperty="roomId">
        insert into sys_meeting_room
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="roomName != null and roomName != ''">room_name,</if>
            <if test="roomCode != null">room_code,</if>
            <if test="location != null and location != ''">location,</if>
            <if test="capacity != null">capacity,</if>
            <if test="roomType != null and roomType != ''">room_type,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="description != null">description,</if>
            <if test="isEnabled != null">is_enabled,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="roomName != null and roomName != ''">#{roomName},</if>
            <if test="roomCode != null">#{roomCode},</if>
            <if test="location != null and location != ''">#{location},</if>
            <if test="capacity != null">#{capacity},</if>
            <if test="roomType != null and roomType != ''">#{roomType},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="description != null">#{description},</if>
            <if test="isEnabled != null">#{isEnabled},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysMeetingRoom" parameterType="SysMeetingRoom">
        update sys_meeting_room
        <trim prefix="SET" suffixOverrides=",">
            <if test="roomName != null and roomName != ''">room_name = #{roomName},</if>
            <if test="roomCode != null">room_code = #{roomCode},</if>
            <if test="location != null and location != ''">location = #{location},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="roomType != null and roomType != ''">room_type = #{roomType},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="description != null">description = #{description},</if>
            <if test="isEnabled != null">is_enabled = #{isEnabled},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where room_id = #{roomId}
    </update>

    <delete id="deleteSysMeetingRoomByRoomId" parameterType="Long">
        delete from sys_meeting_room where room_id = #{roomId}
    </delete>

    <delete id="deleteSysMeetingRoomByRoomIds" parameterType="String">
        delete from sys_meeting_room where room_id in 
        <foreach item="roomId" collection="array" open="(" separator="," close=")">
            #{roomId}
        </foreach>
    </delete>
</mapper>